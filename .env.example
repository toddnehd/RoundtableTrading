DATABASE_URL=postgresql://roundtable:roundtable_dev_password@localhost:5432/roundtable_trading
REDIS_URL=redis://localhost:6379/0

# ── LLM ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

LOG_LEVEL=INFO
ENVIRONMENT=development

# ── 한국투자증권 KIS API ────────────────────────────────────────────────────────
# 발급: https://apiportal.koreainvestment.com → 앱 생성
# KIS_IS_VIRTUAL=true 이면 모의투자, false 이면 실전투자
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT_NUMBER=your_account_number_here
KIS_IS_VIRTUAL=false

# ── 한국 금융 데이터 API ────────────────────────────────────────────────────────
# DART: https://opendart.fss.or.kr → 인증키 신청
# ECOS: https://ecos.bok.or.kr/#/AuthKeyInfo → 인증키 신청 (무료)
DART_API_KEY=your_dart_api_key_here
ECOS_API_KEY=your_ecos_api_key_here

# ── 네이버 검색 API ─────────────────────────────────────────────────────────────
# 발급: https://developers.naver.com/apps/#/register → 검색 API 선택
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# ── 백테스트 설정 ───────────────────────────────────────────────────────────────
BACKTEST_START_DATE=2020-01-01
BACKTEST_INITIAL_CAPITAL=10000000

MAX_DEBATE_ROUNDS=5
CONFIDENCE_THRESHOLD=0.7
